<Window x:Class="DISPLAY_SCALER.Views.ImportProfileDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:DISPLAY_SCALER.Converters"
        Height="650" Width="980"
        MinHeight="600" MinWidth="920"
        Background="Transparent"
        WindowStartupLocation="CenterOwner"
        FontFamily="{StaticResource NvFont}"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True"
        ShowInTaskbar="False"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        RenderOptions.ClearTypeHint="Enabled">
    <Window.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVisibility" />
    </Window.Resources>

    <Border Style="{StaticResource NvDialogRoot}" Margin="8">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="72" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Height="58"
                    Margin="0,0,86,0"
                    VerticalAlignment="Top"
                    Background="Transparent"
                    MouseLeftButtonDown="TitleDrag_MouseLeftButtonDown" />

            <Button Grid.Row="0"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Top"
                    Margin="0,14,24,0"
                    Panel.ZIndex="30"
                    Style="{StaticResource NvDialogCloseButton}"
                    Command="{Binding CancelCommand}"
                    ToolTip="Закрыть" />

            <Grid Grid.Row="0" Margin="28,58,28,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="360" />
                    <ColumnDefinition Width="28" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                        <Border Style="{StaticResource NvDialogPanel}" Margin="0,0,0,14">
                            <StackPanel>
                                <TextBlock Text="{Binding DialogTitle}"
                                           Style="{StaticResource NvLabel}"
                                           Foreground="{StaticResource NvGreenBrush}" />
                                <TextBlock Text="{Binding MonitorTitle}"
                                           Style="{StaticResource NvHeader}"
                                           FontSize="23"
                                           Margin="0,5,0,24" />

                                <TextBlock Text="ДАННЫЕ ПРОФИЛЯ"
                                           Foreground="{StaticResource NvGreenBrush}"
                                           FontFamily="{StaticResource NvFont}"
                                           FontSize="16"
                                           FontWeight="SemiBold" />
                                <TextBlock Text="Проверьте и при необходимости измените режим перед импортом."
                                           Foreground="{StaticResource NvTextSecondaryBrush}"
                                           TextWrapping="Wrap"
                                           LineHeight="19"
                                           FontSize="13"
                                           Margin="0,6,0,20" />

                                <Grid Margin="0,0,0,18">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="14" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="ШИРИНА" Style="{StaticResource NvLabel}" />
                                        <TextBox Style="{StaticResource NvDialogTextBox}"
                                                 PreviewTextInput="NumberOnly"
                                                 Text="{Binding WidthText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                 Margin="0,7,0,0" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="ВЫСОТА" Style="{StaticResource NvLabel}" />
                                        <TextBox Style="{StaticResource NvDialogTextBox}"
                                                 PreviewTextInput="NumberOnly"
                                                 Text="{Binding HeightText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                 Margin="0,7,0,0" />
                                    </StackPanel>
                                </Grid>

                                <StackPanel Margin="0,0,0,18">
                                    <TextBlock Text="ЧАСТОТА, ГЦ" Style="{StaticResource NvLabel}" />
                                    <TextBox Style="{StaticResource NvDialogTextBox}"
                                             PreviewTextInput="NumberOnly"
                                             Text="{Binding RefreshRateText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                             Margin="0,7,0,0" />
                                </StackPanel>

                                <TextBlock Text="{Binding EditNotice}"
                                           Foreground="{StaticResource NvTextMutedBrush}"
                                           FontSize="13"
                                           LineHeight="18"
                                           TextWrapping="Wrap" />

                                <Border Background="#1C1010"
                                        BorderBrush="#4A2525"
                                        BorderThickness="1"
                                        CornerRadius="4"
                                        Padding="10"
                                        Margin="0,14,0,0">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Visibility" Value="Visible" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding ValidationMessage}" Value="{x:Null}">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock Text="{Binding ValidationMessage}"
                                               Foreground="#E28B8B"
                                               FontSize="13"
                                               TextWrapping="Wrap" />
                                </Border>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource NvDialogPanel}">
                            <StackPanel>
                                <TextBlock Text="ИМПОРТИРУЕМЫЙ РЕЖИМ"
                                           Foreground="{StaticResource NvGreenBrush}"
                                           FontFamily="{StaticResource NvFont}"
                                           FontSize="15"
                                           FontWeight="SemiBold" />
                                <TextBlock Text="{Binding PreviewLabel}"
                                           Foreground="{StaticResource NvTextPrimaryBrush}"
                                           FontFamily="{StaticResource NvMonoFont}"
                                           FontSize="13"
                                           TextWrapping="Wrap"
                                           Margin="0,12,0,0" />
                                <Border Height="1" Background="{StaticResource NvGreenFaintBrush}" Margin="0,2,0,12" />
                                <TextBlock Text="ЦЕЛЕВОЙ МОНИТОР" Style="{StaticResource NvLabel}" />
                                <TextBlock Text="{Binding TargetTitle}" Foreground="{StaticResource NvTextPrimaryBrush}" FontSize="13" Margin="0,7,0,0" />
                                <TextBlock Text="{Binding TargetCurrentText}" Foreground="{StaticResource NvTextSecondaryBrush}" FontFamily="{StaticResource NvMonoFont}" FontSize="12" Margin="0,4,0,0" />
                                <TextBlock Text="{Binding TargetRangeText}" Foreground="{StaticResource NvTextSecondaryBrush}" FontFamily="{StaticResource NvMonoFont}" FontSize="12" Margin="0,2,0,0" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <Grid Grid.Column="2" ClipToBounds="False">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0"
                               Text="ПРЕДПРОСМОТР FOV"
                               Style="{StaticResource NvLabel}" />

                    <TextBlock Grid.Row="1"
                               Text="{Binding PreviewLabel}"
                               FontFamily="{StaticResource NvMonoFont}"
                               FontSize="28"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource NvGreenBrush}"
                               Margin="0,7,0,16" />

                    <Border Grid.Row="2"
                            Width="430"
                            Height="242"
                            Style="{StaticResource NvPreviewFrame}"
                            HorizontalAlignment="Left"
                            ClipToBounds="True">
                        <Canvas Width="430" Height="242" ClipToBounds="True">
                            <Image Source="pack://application:,,,/Resources/Images/GAME.png"
                                   Width="430"
                                   Height="242"
                                   Stretch="UniformToFill"
                                   RenderOptions.BitmapScalingMode="HighQuality" />

                            <Border Width="430"
                                    Height="242"
                                    BorderBrush="{StaticResource NvGreenDimBrush}"
                                    BorderThickness="3"
                                    Background="Transparent" />

                            <Border Canvas.Left="0"
                                    Canvas.Top="0"
                                    Width="{Binding CropLeftWidth}"
                                    Height="242"
                                    Background="#9A260606" />
                            <Border Canvas.Left="{Binding CropRightLeft}"
                                    Canvas.Top="0"
                                    Width="{Binding CropLeftWidth}"
                                    Height="242"
                                    Background="#9A260606" />
                            <Border Canvas.Left="0"
                                    Canvas.Top="0"
                                    Width="430"
                                    Height="{Binding CropTopHeight}"
                                    Background="#9A260606" />
                            <Border Canvas.Left="0"
                                    Canvas.Top="{Binding CropBottomTop}"
                                    Width="430"
                                    Height="{Binding CropTopHeight}"
                                    Background="#9A260606" />

                            <Border Canvas.Left="12"
                                    Canvas.Top="12"
                                    Background="#DD090909"
                                    BorderBrush="{StaticResource NvGreenDimBrush}"
                                    BorderThickness="1"
                                    CornerRadius="4"
                                    Padding="10,6">
                                <TextBlock Text="{Binding PreviewChip}"
                                           FontFamily="{StaticResource NvMonoFont}"
                                           FontSize="12"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource NvGreenBrush}" />
                            </Border>
                        </Canvas>
                    </Border>

                    <TextBlock Grid.Row="3"
                               Text="{Binding PreviewFovLabel}"
                               Foreground="{StaticResource NvTextSecondaryBrush}"
                               FontSize="13"
                               LineHeight="20"
                               Margin="0,14,6,16"
                               TextWrapping="Wrap" />

                    <Grid Grid.Row="4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="18" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Style="{StaticResource NvDialogPanel}" Padding="16">
                            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                <StackPanel>
                                    <TextBlock Text="ПЛАН ИМПОРТА" Foreground="{StaticResource NvGreenBrush}" FontFamily="{StaticResource NvFont}" FontSize="15" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding Summary}" Foreground="{StaticResource NvTextPrimaryBrush}" TextWrapping="Wrap" FontSize="13" LineHeight="18" Margin="0,10,0,0" />
                                    <TextBlock Text="{Binding CompatibilityStatus}" Foreground="{StaticResource NvTextSecondaryBrush}" TextWrapping="Wrap" FontSize="12" LineHeight="17" Margin="0,8,0,0" />
                                    <Border Height="1" Background="{StaticResource NvGreenFaintBrush}" Margin="0,12,0,12" />
                                    <TextBlock Text="РИСК" Style="{StaticResource NvLabel}" />
                                    <Border MinHeight="32" Margin="0,4,0,12">
                                        <TextBlock Text="{Binding RiskLevel}"
                                                   Foreground="{StaticResource NvGreenBrush}"
                                                   FontFamily="{StaticResource NvMonoFont}"
                                                   FontSize="18"
                                                   FontWeight="SemiBold"
                                                   LineHeight="26"
                                                   LineStackingStrategy="BlockLineHeight"
                                                   VerticalAlignment="Center" />
                                    </Border>
                                    <TextBlock Text="PIXEL CLOCK" Style="{StaticResource NvLabel}" />
                                    <TextBlock Text="{Binding PixelClockText}" Foreground="{StaticResource NvTextPrimaryBrush}" FontFamily="{StaticResource NvMonoFont}" FontSize="16" LineHeight="22" Margin="0,3,0,0" />
                                </StackPanel>
                            </ScrollViewer>
                        </Border>

                        <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <StackPanel>
                                <Border Background="#1C1010"
                                        BorderBrush="#4A2525"
                                        BorderThickness="1"
                                        CornerRadius="6"
                                        Padding="12"
                                        Margin="0,0,0,10"
                                        Visibility="{Binding HasBlockingIssues, Converter={StaticResource BoolToVisibility}}">
                                    <StackPanel>
                                        <TextBlock Text="КРИТИЧНО" Foreground="#E28B8B" FontWeight="SemiBold" FontSize="13" />
                                        <ItemsControl ItemsSource="{Binding BlockingIssues}" Margin="0,6,0,0">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding StringFormat={}• {0}}" Foreground="#E28B8B" TextWrapping="Wrap" FontSize="12" LineHeight="17" Margin="0,2,0,0" />
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>

                                <Border Background="#1F190B"
                                        BorderBrush="#4D3912"
                                        BorderThickness="1"
                                        CornerRadius="6"
                                        Padding="12"
                                        Margin="0,0,0,10"
                                        Visibility="{Binding HasWarnings, Converter={StaticResource BoolToVisibility}}">
                                    <StackPanel>
                                        <TextBlock Text="ПРЕДУПРЕЖДЕНИЯ" Foreground="{StaticResource NvAmberBrush}" FontWeight="SemiBold" FontSize="13" />
                                        <ItemsControl ItemsSource="{Binding Warnings}" Margin="0,6,0,0">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding StringFormat={}• {0}}" Foreground="{StaticResource NvTextSecondaryBrush}" TextWrapping="Wrap" FontSize="12" LineHeight="17" Margin="0,2,0,0" />
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </Grid>
            </Grid>

            <Border Grid.Row="1"
                    Background="#AA0E0F0E"
                    BorderBrush="{StaticResource NvGreenFaintBrush}"
                    BorderThickness="0,1,0,0">
                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Margin="28,0">
                    <Button Content="Отмена"
                            Style="{StaticResource NvDialogButtonSecondary}"
                            Margin="0,0,12,0"
                            Command="{Binding CancelCommand}" />
                    <Button Content="{Binding ConfirmButtonText}"
                            Style="{StaticResource NvDialogButtonPrimary}"
                            Command="{Binding ConfirmCommand}" />
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
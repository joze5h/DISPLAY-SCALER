<Window x:Class="DISPLAY_SCALER.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        mc:Ignorable="d"
        Title="DISPLAY-SCALER"
        Height="760" Width="1280"
        MinHeight="760" MinWidth="1280"
        Background="{StaticResource NvBlackBrush}"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="CanResize"
        FontFamily="{StaticResource NvFont}"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        RenderOptions.ClearTypeHint="Enabled">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0"
                            ResizeBorderThickness="6"
                            GlassFrameThickness="0"
                            CornerRadius="0"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="34" />
            <RowDefinition Height="*" />
            <RowDefinition Height="42" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="{StaticResource NvSurfaceBrush}"
                BorderThickness="0,0,0,1"
                MouseLeftButtonDown="TitleBar_MouseLeftButtonDown"
                SnapsToDevicePixels="True">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Text="DISPLAY-SCALER"
                           Margin="14,0,0,0"
                           VerticalAlignment="Center"
                           Foreground="{StaticResource NvGreenBrush}"
                           FontSize="12"
                           FontWeight="SemiBold"
                           TextOptions.TextFormattingMode="Display"
                           TextOptions.TextRenderingMode="ClearType" />

                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Stretch"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button Style="{StaticResource NvTitleBarButton}"
                            Click="Minimize_Click"
                            ToolTip="Свернуть">
                        <Grid Width="18" Height="18" SnapsToDevicePixels="True">
                            <Rectangle Width="14"
                                       Height="2"
                                       Fill="#F0F0F0"
                                       RadiusX="1"
                                       RadiusY="1"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       SnapsToDevicePixels="True" />
                        </Grid>
                    </Button>
                    <Button Style="{StaticResource NvTitleBarButton}"
                            Click="MaximizeRestore_Click"
                            ToolTip="Развернуть / восстановить">
                        <Grid Width="18" Height="18" SnapsToDevicePixels="True">
                            <Rectangle Width="14" Height="12"
                                       Stroke="#F0F0F0"
                                       StrokeThickness="2"
                                       RadiusX="0.6" RadiusY="0.6"
                                       Fill="Transparent"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       SnapsToDevicePixels="True" />
                        </Grid>
                    </Button>
                    <Button Style="{StaticResource NvTitleBarCloseButton}"
                            Click="Close_Click"
                            ToolTip="Закрыть">
                        <Grid Width="18" Height="18" SnapsToDevicePixels="True">
                            <Line X1="4" Y1="4" X2="14" Y2="14"
                                  Stroke="#F0F0F0"
                                  StrokeThickness="2"
                                  StrokeStartLineCap="Square"
                                  StrokeEndLineCap="Square"
                                  SnapsToDevicePixels="True" />
                            <Line X1="14" Y1="4" X2="4" Y2="14"
                                  Stroke="#F0F0F0"
                                  StrokeThickness="2"
                                  StrokeStartLineCap="Square"
                                  StrokeEndLineCap="Square"
                                  SnapsToDevicePixels="True" />
                        </Grid>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <Image Grid.Row="1" Grid.RowSpan="2"
               Source="pack://application:,,,/Resources/Images/FON.jpg"
               Stretch="UniformToFill"
               IsHitTestVisible="False">
            <Image.Effect>
                <BlurEffect Radius="10" />
            </Image.Effect>
        </Image>
        <Border Grid.Row="1" Grid.RowSpan="2" Background="#DE060706" IsHitTestVisible="False" />

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="310" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="#D90E0F0E"
                    BorderBrush="{StaticResource NvBorderBrush}" BorderThickness="0,0,1,0">
                <Grid Margin="18">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="ДИСПЛЕИ" Style="{StaticResource NvLabel}" />
                            <TextBlock Foreground="{StaticResource NvTextSecondaryBrush}" FontSize="12" Margin="0,4,0,0">
                                <Run Text="Найдено: " /><Run Text="{Binding Monitors.Count, Mode=OneWay}" />
                            </TextBlock>
                        </StackPanel>
                        <Button Grid.Column="1" Content="Обновить" Style="{StaticResource NvButtonSecondary}"
                                Command="{Binding RefreshCommand}" Padding="12,6" VerticalAlignment="Top" />
                    </Grid>

                    <ListBox Grid.Row="1"
                             ItemsSource="{Binding Monitors}"
                             SelectedItem="{Binding SelectedMonitor}"
                             ItemContainerStyle="{StaticResource NvMonitorListItem}"
                             Background="Transparent"
                             BorderThickness="0"
                             Padding="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.Style>
                            <Style TargetType="{x:Type ListBox}" BasedOn="{StaticResource NvListBoxBase}">
                                <Setter Property="IsEnabled" Value="True" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsBusy}" Value="True">
                                        <Setter Property="IsEnabled" Value="False" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ListBox.Style>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Row="0" Grid.Column="0"
                                               Text="{Binding DisplayTitle}"
                                               Foreground="{StaticResource NvTextPrimaryBrush}"
                                               FontSize="13" FontWeight="SemiBold"
                                               TextTrimming="CharacterEllipsis" />

                                    <Border Grid.Row="0" Grid.Column="1"
                                            Background="#203008" CornerRadius="2" Padding="6,2">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsPrimary}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock Text="ОСНОВНОЙ" Foreground="{StaticResource NvGreenBrush}"
                                                   FontSize="9" FontWeight="SemiBold" />
                                    </Border>

                                    <TextBlock Grid.Row="1" Grid.ColumnSpan="2"
                                               Text="{Binding CurrentModeText}"
                                               Foreground="{StaticResource NvTextSecondaryBrush}"
                                               FontSize="11" Margin="0,5,0,0" />
                                    <TextBlock Grid.Row="2" Grid.ColumnSpan="2"
                                               Text="{Binding AdapterName}"
                                               Foreground="{StaticResource NvTextMutedBrush}"
                                               FontSize="10" Margin="0,3,0,0"
                                               TextTrimming="CharacterEllipsis" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <Border Grid.Row="2"
                            Background="#660A0C0A"
                            BorderBrush="{StaticResource NvBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="10"
                            Margin="0,14,0,0">
                        <StackPanel>
                            <TextBlock Text="GPU ДРАЙВЕР"
                                       Style="{StaticResource NvLabel}"
                                       Foreground="{StaticResource NvGreenBrush}" />
                            <TextBlock Text="Полный сброс удаляет все кастомные режимы и может решить проблемы с отображением. Экран временно погасненет, это нормально."
                                       Foreground="{StaticResource NvTextMutedBrush}"
                                       FontSize="14"
                                       TextWrapping="Wrap"
                                       Margin="0,5,0,9" />
                            <Button Content="Полный сброс"
                                    Style="{StaticResource NvButtonDanger}"
                                    Command="{Binding FullDisplayResetCommand}"
                                    HorizontalAlignment="Stretch"
                                    Padding="10,7"
                                    Margin="0,0,0,8"
                                    ToolTip="Сбрасывает EDID override, EDID-кэш и Windows-конфигурации всех дисплеев по логике CRU reset-all.exe, затем автоматически перезапускает графический драйвер." />
                            <Button Content="Перезагрузить драйвер"
                                    Style="{StaticResource NvButtonSecondary}"
                                    Command="{Binding RestartGpuDriverCommand}"
                                    HorizontalAlignment="Stretch"
                                    Padding="10,7"
                                    ToolTip="Вручную перезапускает присутствующие display-адаптеры через SetupAPI: DICS_DISABLE, затем DICS_ENABLE, по основной логике CRU restart64.exe." />
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <ScrollViewer Grid.Column="1" Style="{StaticResource NvScrollViewer}"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <Grid Margin="22">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="14" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="14" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Style="{StaticResource NvMetricPanel}" Background="Transparent" CornerRadius="15">
                            <StackPanel>
                                <TextBlock Text="РАЗРЕШЕНИЕ ДИСПЛЕЯ" Style="{StaticResource NvMetricLabel}" />
                                <TextBlock Text="{Binding SelectedMonitor.CurrentResolutionText}" Style="{StaticResource NvValue}" Margin="0,6,0,0" />
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="2" Style="{StaticResource NvMetricPanel}" Background="Transparent" CornerRadius="15">
                            <StackPanel>
                                <TextBlock Text="ЧАСТОТА ДИСПЛЕЯ" Style="{StaticResource NvMetricLabel}" />
                                <TextBlock Text="{Binding SelectedMonitor.CurrentRefreshText}" Style="{StaticResource NvValue}" Margin="0,6,0,0"
                                           TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="4" Style="{StaticResource NvMetricPanel}" Background="Transparent" CornerRadius="15">
                            <StackPanel>
                                <TextBlock Text="ВИДЕОКАРТА" Style="{StaticResource NvMetricLabel}" />
                                <TextBlock Text="{Binding SelectedMonitor.AdapterName}" Style="{StaticResource NvValue}" Margin="0,6,0,0"
                                           TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </Border>
                    </Grid>

                    <Grid Grid.Row="1" Margin="0,14,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0" Style="{StaticResource NvPanel}" Background="Transparent" CornerRadius="15">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="275" MinWidth="245" />
                                    <ColumnDefinition Width="20" />
                                    <ColumnDefinition Width="*" MinWidth="520" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="ДОБАВИТЬ РАЗРЕШЕНИЕ" Style="{StaticResource NvLabel}" />
                                    <TextBlock Text="Новый режим" Style="{StaticResource NvHeader}" Margin="0,4,0,12" />
                                    <Button Content="+ Добавить" Style="{StaticResource NvButtonPrimary}"
                                            Command="{Binding AddCustomResolutionCommand}"
                                            HorizontalAlignment="Stretch" />

                                    <Grid Margin="0,10,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="8" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Button Grid.Column="0"
                                                Content="Импорт"
                                                Style="{StaticResource NvButtonSecondary}"
                                                Command="{Binding ImportProfileCommand}"
                                                HorizontalAlignment="Stretch"
                                                Padding="10,7" />
                                        <Button Grid.Column="2"
                                                Content="Экспорт"
                                                Style="{StaticResource NvButtonSecondary}"
                                                Command="{Binding ExportProfileCommand}"
                                                HorizontalAlignment="Stretch"
                                                Padding="10,7" />
                                    </Grid>
                                    <Grid Margin="0,8,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="8" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Button Grid.Column="0"
                                                Content="Копировать"
                                                Style="{StaticResource NvButtonSecondary}"
                                                Command="{Binding CopyResolutionCommand}"
                                                HorizontalAlignment="Stretch"
                                                Padding="10,7" />
                                        <Button Grid.Column="2"
                                                Content="Вставить"
                                                Style="{StaticResource NvButtonSecondary}"
                                                Command="{Binding PasteResolutionCommand}"
                                                HorizontalAlignment="Stretch"
                                                Padding="10,7" />
                                    </Grid>
                                    <TextBlock Text="{Binding ClipboardResolutionText}"
                                               Foreground="{StaticResource NvTextMutedBrush}"
                                               FontSize="14"
                                               TextWrapping="Wrap"
                                               Margin="0,7,0,0" />
                                    <TextBlock Text="конфиги проверяются перед установкой кастомных разрешений"
                                               Foreground="{StaticResource NvTextMutedBrush}"
                                               FontSize="14"
                                               TextWrapping="Wrap"
                                               Margin="0,3,0,0" />

                                    <Border Height="3" Background="{StaticResource NvBorderBrush}" Margin="0,16,0,14" />

                                    <TextBlock Text="БЫСТРЫЕ ПРЕСЕТЫ" Style="{StaticResource NvLabel}" Margin="0,0,0,6" />
                                    <TextBlock Text="Герцовка берется с текущего монитора" Foreground="{StaticResource NvTextMutedBrush}"
                                               FontSize="14" TextWrapping="Wrap" Margin="0,0,0,10" />
                                    <Border Background="#660A0C0A"
                                            BorderBrush="{StaticResource NvBorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="7"
                                            Padding="8"
                                            MaxHeight="270">
                                        <ScrollViewer Style="{StaticResource NvScrollViewer}"
                                                      VerticalScrollBarVisibility="Auto"
                                                      HorizontalScrollBarVisibility="Disabled"
                                                      CanContentScroll="False">
                                            <ItemsControl ItemsSource="{Binding EsportsPresetGroups}">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <StackPanel />
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <StackPanel Margin="0,0,0,8">
                                                            <TextBlock Text="{Binding AspectRatio}"
                                                                       Foreground="{StaticResource NvGreenBrush}"
                                                                       FontFamily="{StaticResource NvMonoFont}"
                                                                       FontSize="13"
                                                                       FontWeight="SemiBold"
                                                                       Margin="0,6,0,6" />
                                                            <ItemsControl ItemsSource="{Binding Presets}">
                                                                <ItemsControl.ItemsPanel>
                                                                    <ItemsPanelTemplate>
                                                                        <StackPanel />
                                                                    </ItemsPanelTemplate>
                                                                </ItemsControl.ItemsPanel>
                                                                <ItemsControl.ItemTemplate>
                                                                    <DataTemplate>
                                                                        <Button Command="{Binding DataContext.ApplyPresetCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                                CommandParameter="{Binding}"
                                                                                Style="{StaticResource NvButtonSecondary}"
                                                                                HorizontalAlignment="Stretch"
                                                                                Margin="0,0,0,8"
                                                                                Padding="12,8">
                                                                            <Grid>
                                                                                <Grid.RowDefinitions>
                                                                                    <RowDefinition Height="Auto" />
                                                                                    <RowDefinition Height="Auto" />
                                                                                </Grid.RowDefinitions>
                                                                                <TextBlock Grid.Row="0"
                                                                                           Text="{Binding Name}"
                                                                                           FontSize="13"
                                                                                           FontFamily="{StaticResource NvMonoFont}"
                                                                                           Foreground="{StaticResource NvTextPrimaryBrush}"
                                                                                           HorizontalAlignment="Center" />
                                                                                <TextBlock Grid.Row="1"
                                                                                           Text="{Binding DataContext.AdaptivePresetRefreshText, RelativeSource={RelativeSource AncestorType=Window}, Mode=OneWay}"
                                                                                           Foreground="{StaticResource NvTextMutedBrush}"
                                                                                           FontSize="11"
                                                                                           HorizontalAlignment="Center"
                                                                                           Margin="0,2,0,0" />
                                                                            </Grid>
                                                                        </Button>
                                                                    </DataTemplate>
                                                                </ItemsControl.ItemTemplate>
                                                            </ItemsControl>
                                                        </StackPanel>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </ScrollViewer>
                                    </Border>
                                </StackPanel>

                                <Grid Grid.Column="2">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="340" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <StackPanel Grid.Row="0" Margin="0,0,0,12">
                                        <TextBlock Text="СПИСОК РАЗРЕШЕНИЙ" Style="{StaticResource NvLabel}" />
                                        <TextBlock Text="Разделено по источнику" Style="{StaticResource NvHeader}" Margin="0,4,0,0" />
                                    </StackPanel>

                                    <Grid Grid.Row="1">
                                        <Grid.Resources>
                                            <CollectionViewSource x:Key="ExternalCustomResolutionView" Source="{Binding ExternalCustomResolutions}">
                                                <CollectionViewSource.GroupDescriptions>
                                                    <PropertyGroupDescription PropertyName="AspectRatio" />
                                                </CollectionViewSource.GroupDescriptions>
                                            </CollectionViewSource>
                                        </Grid.Resources>

                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="10" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="10" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>

                                        <Border Grid.Column="0" Background="#660A0C0A" BorderBrush="{StaticResource NvBorderBrush}"
                                                BorderThickness="1" CornerRadius="9" Padding="10" VerticalAlignment="Stretch">
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="*" />
                                                </Grid.RowDefinitions>
                                                <TextBlock Grid.Row="0" Text="ДОБАВЛЕНО ЧЕРЕЗ DISPLAY-SCALER" Style="{StaticResource NvLabel}"
                                                           Foreground="{StaticResource NvGreenBrush}" Margin="0,0,0,8" TextWrapping="Wrap" />
                                                <ListBox x:Name="DisplayScalerResolutionList"
                                                         Grid.Row="1"
                                                         ItemsSource="{Binding DisplayScalerCustomResolutions}"
                                                         SelectedItem="{Binding SelectedDisplayScalerResolution, Mode=TwoWay}"
                                                         PreviewMouseLeftButtonDown="ResolutionList_PreviewMouseLeftButtonDown"
                                                         ItemContainerStyle="{StaticResource NvCustomResolutionListItem}"
                                                         Style="{StaticResource NvListBoxBase}"
                                                         Background="Transparent" BorderThickness="0"
                                                         Padding="0"
                                                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                                         ScrollViewer.CanContentScroll="False"
                                                         VirtualizingPanel.IsVirtualizing="False"
                                                         SnapsToDevicePixels="True">
                                                    <ListBox.ItemTemplate>
                                                        <DataTemplate>
                                                            <Grid>
                                                                <Grid.RowDefinitions>
                                                                    <RowDefinition Height="Auto" />
                                                                    <RowDefinition Height="Auto" />
                                                                </Grid.RowDefinitions>
                                                                <TextBlock Grid.Row="0" FontFamily="{StaticResource NvMonoFont}" FontSize="16"
                                                                           Foreground="{StaticResource NvGreenBrush}" TextTrimming="CharacterEllipsis">
                                                                    <Run Text="{Binding Width, Mode=OneWay}" /><Run Text="×" /><Run Text="{Binding Height, Mode=OneWay}" />
                                                                </TextBlock>
                                                                <TextBlock Grid.Row="1" FontSize="12" Foreground="{StaticResource NvTextMutedBrush}" Margin="0,5,0,0">
                                                                    <Run Text="@ " /><Run Text="{Binding RefreshRateLabel, Mode=OneWay}" />
                                                                    <Run Text="  ·  " /><Run Text="{Binding AspectRatio, Mode=OneWay}" />
                                                                </TextBlock>
                                                            </Grid>
                                                        </DataTemplate>
                                                    </ListBox.ItemTemplate>
                                                </ListBox>
                                            </Grid>
                                        </Border>

                                        <Border Grid.Column="2" Background="#660A0C0A" BorderBrush="{StaticResource NvBorderBrush}"
                                                BorderThickness="1" CornerRadius="9" Padding="10" VerticalAlignment="Stretch">
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="*" />
                                                </Grid.RowDefinitions>
                                                <TextBlock Grid.Row="0" Text="КАСТОМНЫЕ" Style="{StaticResource NvLabel}" Margin="0,0,0,8" />
                                                <ListBox x:Name="ExternalCustomResolutionList"
                                                         Grid.Row="1"
                                                         ItemsSource="{Binding Source={StaticResource ExternalCustomResolutionView}}"
                                                         SelectedItem="{Binding SelectedExternalCustomResolution, Mode=TwoWay}"
                                                         PreviewMouseLeftButtonDown="ResolutionList_PreviewMouseLeftButtonDown"
                                                         ItemContainerStyle="{StaticResource NvCustomResolutionListItem}"
                                                         Style="{StaticResource NvListBoxBase}"
                                                         Background="Transparent" BorderThickness="0"
                                                         Padding="0"
                                                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                                         ScrollViewer.CanContentScroll="False"
                                                         VirtualizingPanel.IsVirtualizing="False"
                                                         SnapsToDevicePixels="True">
                                                    <ListBox.GroupStyle>
                                                        <GroupStyle>
                                                            <GroupStyle.HeaderTemplate>
                                                                <DataTemplate>
                                                                    <TextBlock Text="{Binding Name}"
                                                                               Foreground="{StaticResource NvGreenBrush}"
                                                                               FontFamily="{StaticResource NvMonoFont}"
                                                                               FontSize="13"
                                                                               FontWeight="SemiBold"
                                                                               Margin="4,8,0,5" />
                                                                </DataTemplate>
                                                            </GroupStyle.HeaderTemplate>
                                                        </GroupStyle>
                                                    </ListBox.GroupStyle>
                                                    <ListBox.ItemTemplate>
                                                        <DataTemplate>
                                                            <Grid>
                                                                <Grid.RowDefinitions>
                                                                    <RowDefinition Height="Auto" />
                                                                    <RowDefinition Height="Auto" />
                                                                </Grid.RowDefinitions>
                                                                <TextBlock Grid.Row="0" FontFamily="{StaticResource NvMonoFont}" FontSize="16"
                                                                           Foreground="{StaticResource NvTextPrimaryBrush}" TextTrimming="CharacterEllipsis">
                                                                    <Run Text="{Binding Width, Mode=OneWay}" /><Run Text="×" /><Run Text="{Binding Height, Mode=OneWay}" />
                                                                </TextBlock>
                                                                <TextBlock Grid.Row="1" FontSize="12" Foreground="{StaticResource NvTextMutedBrush}" Margin="0,5,0,0">
                                                                    <Run Text="@ " /><Run Text="{Binding RefreshRateLabel, Mode=OneWay}" />
                                                                </TextBlock>
                                                            </Grid>
                                                        </DataTemplate>
                                                    </ListBox.ItemTemplate>
                                                </ListBox>
                                            </Grid>
                                        </Border>

                                        <Border Grid.Column="4" Background="#660A0C0A" BorderBrush="{StaticResource NvBorderBrush}"
                                                BorderThickness="1" CornerRadius="9" Padding="10" VerticalAlignment="Stretch">
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="*" />
                                                </Grid.RowDefinitions>
                                                <TextBlock Grid.Row="0" Text="СИСТЕМНЫЕ" Style="{StaticResource NvLabel}" Margin="0,0,0,8" />
                                                <ListBox x:Name="SystemResolutionList"
                                                         Grid.Row="1"
                                                         ItemsSource="{Binding SystemResolutions}"
                                                         SelectedItem="{Binding SelectedSystemResolution, Mode=TwoWay}"
                                                         PreviewMouseLeftButtonDown="ResolutionList_PreviewMouseLeftButtonDown"
                                                         ItemContainerStyle="{StaticResource NvCustomResolutionListItem}"
                                                         Style="{StaticResource NvListBoxBase}"
                                                         Background="Transparent" BorderThickness="0"
                                                         Padding="0"
                                                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                                         ScrollViewer.CanContentScroll="False"
                                                         VirtualizingPanel.IsVirtualizing="False"
                                                         SnapsToDevicePixels="True">
                                                    <ListBox.ItemTemplate>
                                                        <DataTemplate>
                                                            <Grid>
                                                                <Grid.RowDefinitions>
                                                                    <RowDefinition Height="Auto" />
                                                                    <RowDefinition Height="Auto" />
                                                                </Grid.RowDefinitions>
                                                                <TextBlock Grid.Row="0" FontFamily="{StaticResource NvMonoFont}" FontSize="16"
                                                                           Foreground="{StaticResource NvTextPrimaryBrush}" TextTrimming="CharacterEllipsis">
                                                                    <Run Text="{Binding Width, Mode=OneWay}" /><Run Text="×" /><Run Text="{Binding Height, Mode=OneWay}" />
                                                                </TextBlock>
                                                                <TextBlock Grid.Row="1" FontSize="12" Foreground="{StaticResource NvTextMutedBrush}" Margin="0,5,0,0">
                                                                    <Run Text="@ " /><Run Text="{Binding RefreshRateLabel, Mode=OneWay}" />
                                                                    <Run Text="  ·  " /><Run Text="{Binding AspectRatio, Mode=OneWay}" />
                                                                </TextBlock>
                                                            </Grid>
                                                        </DataTemplate>
                                                    </ListBox.ItemTemplate>
                                                </ListBox>
                                            </Grid>
                                        </Border>
                                    </Grid>

                                    <Grid Grid.Row="2" Margin="0,12,0,0">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <Grid Grid.Row="0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="10" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="10" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Button Grid.Row="0" Grid.Column="0"
                                                    Content="Изменить"
                                                    Style="{StaticResource NvButtonSecondary}"
                                                    Command="{Binding EditCustomResolutionCommand}"
                                                    HorizontalAlignment="Stretch" />
                                            <Button Grid.Row="0" Grid.Column="2"
                                                    Content="Снять выбор"
                                                    Style="{StaticResource NvButtonSecondary}"
                                                    Command="{Binding ClearResolutionSelectionCommand}"
                                                    HorizontalAlignment="Stretch" />
                                            <Button Grid.Row="0" Grid.Column="4"
                                                    Content="Удалить"
                                                    Style="{StaticResource NvButtonDanger}"
                                                    Command="{Binding RemoveCustomResolutionCommand}"
                                                    HorizontalAlignment="Stretch" />
                                        </Grid>
                                        <TextBlock Grid.Row="1"
                                                   Text="{Binding SelectedCustomResolutionText}"
                                                   Foreground="{StaticResource NvTextMutedBrush}"
                                                   FontSize="13"
                                                   Margin="0,8,0,0"
                                                   TextWrapping="Wrap" />
                                    </Grid>
                                </Grid>
                            </Grid>
                        </Border>

                        <Border Grid.Row="1" Style="{StaticResource NvPanel}" Margin="0,14,0,0" Background="Transparent" CornerRadius="15"
                                HorizontalAlignment="Left" Width="430">
                            <StackPanel HorizontalAlignment="Stretch">
                                <Grid Margin="0,0,0,10" HorizontalAlignment="Stretch">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="НАСТРОЙКИ МОНИТОРА" Style="{StaticResource NvLabel}" />
                                        <TextBlock Text="Частота, битность и цвет" Style="{StaticResource NvHeader}" Margin="0,4,0,0" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="1" FontSize="25" FontWeight="SemiBold"
                                               Foreground="{StaticResource NvGreenBrush}">
                                        <Run Text="{Binding Saturation, Mode=OneWay}" /><Run Text="%" />
                                    </TextBlock>
                                </Grid>

                                <Border Height="1" Background="{StaticResource NvBorderBrush}" Margin="0,10,0,14" />

                                <Grid Margin="0,0,0,14">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="10" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Row="0" Grid.ColumnSpan="3" Text="ТЕКУЩАЯ ЧАСТОТА" Style="{StaticResource NvLabel}" />
                                    <ComboBox Grid.Row="1" Grid.Column="0"
                                              Style="{StaticResource NvComboBox}"
                                              ItemsSource="{Binding RefreshRateOptions}"
                                              SelectedItem="{Binding SelectedRefreshRateOption, Mode=TwoWay}"
                                              DisplayMemberPath="Label"
                                              Margin="0,7,0,0" />
                                    <Button Grid.Row="1" Grid.Column="2"
                                            Content="Применить"
                                            Style="{StaticResource NvButtonSecondary}"
                                            Command="{Binding ApplyRefreshRateCommand}"
                                            Padding="10,6"
                                            Margin="0,7,0,0" />
                                </Grid>

                                <Grid Margin="0,0,0,16">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="10" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Row="0" Grid.ColumnSpan="3" Text="БИТНОСТЬ ЦВЕТА" Style="{StaticResource NvLabel}" />
                                    <ComboBox Grid.Row="1" Grid.Column="0"
                                              Style="{StaticResource NvComboBox}"
                                              ItemsSource="{Binding ColorDepthOptions}"
                                              SelectedItem="{Binding SelectedColorDepthOption, Mode=TwoWay}"
                                              DisplayMemberPath="Label"
                                              Margin="0,7,0,0" />
                                    <Button Grid.Row="1" Grid.Column="2"
                                            Content="Применить"
                                            Style="{StaticResource NvButtonSecondary}"
                                            Command="{Binding ApplyColorDepthCommand}"
                                            Padding="10,6"
                                            Margin="0,7,0,0" />
                                </Grid>

                                <Border Height="1" Background="{StaticResource NvBorderBrush}" Margin="0,0,0,14" />

                                <Slider Style="{StaticResource NvSlider}" Minimum="0" Maximum="100"
                                        Value="{Binding Saturation, Mode=TwoWay}" />

                                <Grid Margin="0,4,0,0">
                                    <TextBlock Text="0" HorizontalAlignment="Left" Foreground="{StaticResource NvTextMutedBrush}" FontSize="10" />
                                    <TextBlock Text="50" HorizontalAlignment="Center" Foreground="{StaticResource NvTextMutedBrush}" FontSize="10" />
                                    <TextBlock Text="100" HorizontalAlignment="Right" Foreground="{StaticResource NvTextMutedBrush}" FontSize="10" />
                                </Grid>

                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,14,0,0">
                                    <Button Content="Сброс" Style="{StaticResource NvButtonSecondary}"
                                            Command="{Binding ResetSaturationCommand}" Margin="0,0,8,0" />
                                    <Button Content="Применить" Style="{StaticResource NvButtonPrimary}"
                                            Command="{Binding ApplySaturationCommand}" />
                                </StackPanel>

                                <Border Background="#1C1010" BorderBrush="#4A2525" BorderThickness="1"
                                        CornerRadius="4" Padding="10" Margin="0,12,0,0">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Visibility" Value="Visible" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding SaturationSupported}" Value="True">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock Text="DVC недоступен: нужен NVIDIA-драйвер с поддержкой Digital Vibrance."
                                               Foreground="#E28B8B" FontSize="16" TextWrapping="Wrap" />
                                </Border>
                            </StackPanel>
                        </Border>

                        <Border Grid.Row="2" Style="{StaticResource NvPanel}" Margin="0,14,0,0" Background="Transparent" CornerRadius="15">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <StackPanel Grid.Row="0" Margin="0,0,0,12">
                                    <TextBlock Text="{Binding PreviewModeTitle}" Style="{StaticResource NvLabel}" />
                                    <TextBlock Text="{Binding PreviewModeText}" Style="{StaticResource NvHeader}" Margin="0,4,0,0" TextWrapping="Wrap" />
                                </StackPanel>

                                <Border x:Name="PreviewViewport"
                                        Grid.Row="1"
                                        Background="#070707"
                                        BorderBrush="{StaticResource NvBorderLightBrush}"
                                        BorderThickness="1"
                                        CornerRadius="0"
                                        HorizontalAlignment="Stretch"
                                        Height="520"
                                        SizeChanged="PreviewViewport_SizeChanged"
                                        ClipToBounds="True"
                                        SnapsToDevicePixels="True">
                                    <Grid ClipToBounds="True" SnapsToDevicePixels="True">
                                        <Viewbox Stretch="Fill"
                                                 HorizontalAlignment="Stretch"
                                                 VerticalAlignment="Stretch">
                                            <Canvas Width="{Binding PreviewFrameWidth}" Height="{Binding PreviewFrameHeight}"
                                                    ClipToBounds="True"
                                                    SnapsToDevicePixels="True">
                                                <Image Source="pack://application:,,,/Resources/Images/GAME.png"
                                                       Width="{Binding PreviewFrameWidth}"
                                                       Height="{Binding PreviewFrameHeight}"
                                                       Stretch="UniformToFill"
                                                       RenderOptions.BitmapScalingMode="HighQuality" />
                                                <Border Width="{Binding PreviewFrameWidth}" Height="{Binding PreviewFrameHeight}"
                                                        Background="Transparent"
                                                        BorderBrush="{StaticResource NvGreenBrush}"
                                                        BorderThickness="2" />
                                                <Border Canvas.Left="0" Canvas.Top="0"
                                                        Width="{Binding PreviewCropLeftWidth}"
                                                        Height="{Binding PreviewFrameHeight}"
                                                        Background="#AA260606" />
                                                <Border Canvas.Left="{Binding PreviewCropRightLeft}" Canvas.Top="0"
                                                        Width="{Binding PreviewCropLeftWidth}"
                                                        Height="{Binding PreviewFrameHeight}"
                                                        Background="#AA260606" />
                                                <Border Canvas.Left="0" Canvas.Top="0"
                                                        Width="{Binding PreviewFrameWidth}"
                                                        Height="{Binding PreviewCropTopHeight}"
                                                        Background="#AA260606" />
                                                <Border Canvas.Left="0" Canvas.Top="{Binding PreviewCropBottomTop}"
                                                        Width="{Binding PreviewFrameWidth}"
                                                        Height="{Binding PreviewCropTopHeight}"
                                                        Background="#AA260606" />
                                            </Canvas>
                                        </Viewbox>

                                        <Border HorizontalAlignment="Left"
                                                VerticalAlignment="Top"
                                                Margin="12"
                                                Background="#EA090909"
                                                BorderBrush="{StaticResource NvBorderBrush}"
                                                BorderThickness="1"
                                                CornerRadius="3"
                                                Padding="10,6"
                                                SnapsToDevicePixels="True">
                                            <TextBlock Text="{Binding PreviewCustomText}"
                                                       Foreground="{StaticResource NvGreenBrush}"
                                                       FontFamily="{StaticResource NvMonoFont}"
                                                       FontSize="17"
                                                       FontWeight="SemiBold"
                                                       TextOptions.TextFormattingMode="Display"
                                                       TextOptions.TextRenderingMode="ClearType" />
                                        </Border>
                                    </Grid>
                                </Border>

                                <TextBlock Grid.Row="2" Text="{Binding PreviewModeDetailText}" Foreground="#E28B8B"
                                           FontSize="16" Margin="0,10,0,0" TextWrapping="Wrap" />
                                <TextBlock Grid.Row="3" Foreground="{StaticResource NvTextMutedBrush}" FontSize="16" Margin="0,8,0,0" TextWrapping="Wrap">
                                    <Run Text="Базовое: " /><Run Text="{Binding PreviewNativeText, Mode=OneWay}" />
                                    <Run Text="  -  Кастомное: " /><Run Text="{Binding PreviewCustomText, Mode=OneWay}" />
                                </TextBlock>
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>
            </ScrollViewer>
        </Grid>

        <Border Grid.Row="2" Background="{StaticResource NvSurfaceBrush}"
                BorderBrush="{StaticResource NvBorderBrush}" BorderThickness="0,1,0,0">
            <Grid Margin="22,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel  Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Foreground="{StaticResource NvGreenBrush}"
               FontSize="12"
               FontWeight="SemiBold"
               VerticalAlignment="Center"
               TextOptions.TextFormattingMode="Display"
               TextOptions.TextRenderingMode="ClearType">
        <Hyperlink Command="{Binding OpenDwtLinkCommand}"
                   Foreground="{StaticResource NvGreenBrush}"
                   TextDecorations="None"
                   Cursor="Hand">VERSION FROM D.W.T [BETA]</Hyperlink>
                    </TextBlock>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>

<Window x:Class="DISPLAY_SCALER.Views.AddCustomResolutionDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Height="650" Width="980"
        MinHeight="600" MinWidth="920"
        Background="Transparent"
        WindowStartupLocation="CenterOwner"
        FontFamily="{StaticResource NvFont}"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True"
        ShowInTaskbar="False"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        RenderOptions.ClearTypeHint="Enabled">

    <Border Style="{StaticResource NvDialogRoot}" Margin="8">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="72" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Height="58"
                    Margin="0,0,86,0"
                    VerticalAlignment="Top"
                    Background="Transparent"
                    MouseLeftButtonDown="TitleDrag_MouseLeftButtonDown" />

            <Button Grid.Row="0"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Top"
                    Margin="0,14,24,0"
                    Panel.ZIndex="30"
                    Style="{StaticResource NvDialogCloseButton}"
                    Command="{Binding CancelCommand}"
                    ToolTip="Закрыть" />

            <Grid Grid.Row="0" Margin="28,58,28,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="360" />
                    <ColumnDefinition Width="28" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource NvDialogPanel}">
                    <StackPanel>
                        <TextBlock Text="{Binding DialogTitle}"
                                   Style="{StaticResource NvLabel}"
                                   Foreground="{StaticResource NvGreenBrush}" />
                        <TextBlock Text="{Binding MonitorTitle}"
                                   Style="{StaticResource NvHeader}"
                                   FontSize="23"
                                   Margin="0,5,0,24" />

                        <TextBlock Text="ПАРАМЕТРЫ" Style="{StaticResource NvLabel}" />
                        <TextBlock Text="Введите ширину, высоту и частоту дисплея вручную"
                                   Foreground="{StaticResource NvTextSecondaryBrush}"
                                   FontSize="13"
                                   Margin="0,6,0,20" />

                        <Grid Margin="0,0,0,18">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="14" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="ШИРИНА" Style="{StaticResource NvLabel}" />
                                <TextBox Style="{StaticResource NvDialogTextBox}"
                                         PreviewTextInput="NumberOnly"
                                         Text="{Binding WidthText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         Margin="0,7,0,0" />
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock Text="ВЫСОТА" Style="{StaticResource NvLabel}" />
                                <TextBox Style="{StaticResource NvDialogTextBox}"
                                         PreviewTextInput="NumberOnly"
                                         Text="{Binding HeightText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         Margin="0,7,0,0" />
                            </StackPanel>
                        </Grid>

                        <StackPanel Margin="0,0,0,22">
                            <TextBlock Text="ЧАСТОТА, ГЦ" Style="{StaticResource NvLabel}" />
                            <TextBox Style="{StaticResource NvDialogTextBox}"
                                     PreviewTextInput="NumberOnly"
                                     Text="{Binding RefreshRateText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     Margin="0,7,0,0" />
                        </StackPanel>

                        <TextBlock Text="Соотношение сторон будет рассчитано автоматически по введённым значениям."
                                   Foreground="{StaticResource NvTextMutedBrush}"
                                   FontSize="14"
                                   LineHeight="20"
                                   TextWrapping="Wrap" />

                        <Border Background="#1C1010"
                                BorderBrush="#4A2525"
                                BorderThickness="1"
                                CornerRadius="4"
                                Padding="10"
                                Margin="0,14,0,0">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Visibility" Value="Visible" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ValidationMessage}" Value="{x:Null}">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <TextBlock Text="{Binding ValidationMessage}"
                                       Foreground="#E28B8B"
                                       FontSize="13"
                                       TextWrapping="Wrap" />
                        </Border>
                    </StackPanel>
                </Border>

                <Grid Grid.Column="2"
                      Margin="4,8,0,0"
                      ClipToBounds="False">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0"
                               Text="ПРЕДПРОСМОТР FOV"
                               Style="{StaticResource NvLabel}" />

                    <TextBlock Grid.Row="1"
                               Text="{Binding PreviewLabel}"
                               FontFamily="{StaticResource NvMonoFont}"
                               FontSize="28"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource NvGreenBrush}"
                               Margin="0,7,0,16" />

                    <Border Grid.Row="2"
                            Width="430"
                            Height="242"
                            Style="{StaticResource NvPreviewFrame}"
                            HorizontalAlignment="Left"
                            ClipToBounds="True">
                        <Canvas Width="430" Height="242" ClipToBounds="True">
                            <Image Source="pack://application:,,,/Resources/Images/GAME.png"
                                   Width="430"
                                   Height="242"
                                   Stretch="UniformToFill"
                                   RenderOptions.BitmapScalingMode="HighQuality" />

                            <Border Width="430"
                                    Height="242"
                                    BorderBrush="{StaticResource NvGreenDimBrush}"
                                    BorderThickness="3"
                                    Background="Transparent" />

                            <Border Canvas.Left="0"
                                    Canvas.Top="0"
                                    Width="{Binding CropLeftWidth}"
                                    Height="242"
                                    Background="#9A260606" />
                            <Border Canvas.Left="{Binding CropRightLeft}"
                                    Canvas.Top="0"
                                    Width="{Binding CropLeftWidth}"
                                    Height="242"
                                    Background="#9A260606" />
                            <Border Canvas.Left="0"
                                    Canvas.Top="0"
                                    Width="430"
                                    Height="{Binding CropTopHeight}"
                                    Background="#9A260606" />
                            <Border Canvas.Left="0"
                                    Canvas.Top="{Binding CropBottomTop}"
                                    Width="430"
                                    Height="{Binding CropTopHeight}"
                                    Background="#9A260606" />

                            <Border Canvas.Left="12"
                                    Canvas.Top="12"
                                    Background="#DD090909"
                                    BorderBrush="{StaticResource NvGreenDimBrush}"
                                    BorderThickness="1"
                                    CornerRadius="4"
                                    Padding="10,6">
                                <TextBlock Text="{Binding PreviewChip}"
                                           FontFamily="{StaticResource NvMonoFont}"
                                           FontSize="12"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource NvGreenBrush}" />
                            </Border>
                        </Canvas>
                    </Border>

                    <TextBlock Grid.Row="3"
                               Text="{Binding PreviewFovLabel}"
                               Foreground="{StaticResource NvTextSecondaryBrush}"
                               FontSize="13"
                               LineHeight="20"
                               Margin="0,14,6,0"
                               TextWrapping="Wrap" />

                    <Border Grid.Row="4"
                            Height="3"
                            Background="{StaticResource NvGreenFaintBrush}"
                            Margin="0,16,6,12" />

                    <TextBlock Grid.Row="5"
                               Foreground="{StaticResource NvTextMutedBrush}"
                               FontSize="16"
                               LineHeight="19"
                               Margin="0,0,6,0"
                               VerticalAlignment="Top"
                               TextWrapping="Wrap"
                               Text="Красные зоны показывают часть дисплея, которая будет потеряна из-за несовпадения соотношения сторон с нативным разрешением монитора. Важно для тех, кто играет на 4:3 и т.д." />
                </Grid>
            </Grid>

            <Border Grid.Row="1"
                    Background="#AA0E0F0E"
                    BorderBrush="{StaticResource NvGreenFaintBrush}"
                    BorderThickness="0,1,0,0">
                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Margin="28,0">
                    <Button Content="Отмена"
                            Style="{StaticResource NvDialogButtonSecondary}"
                            Margin="0,0,12,0"
                            Command="{Binding CancelCommand}" />
                    <Button Content="{Binding ConfirmButtonText}"
                            Style="{StaticResource NvDialogButtonPrimary}"
                            Command="{Binding ConfirmCommand}" />
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
<Window x:Class="DISPLAY_SCALER.Views.TimedApplyDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Height="430" Width="640"
        MinHeight="320" MinWidth="520"
        Background="Transparent"
        WindowStartupLocation="Manual"
        FontFamily="{StaticResource NvFont}"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True"
        ShowInTaskbar="False"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        RenderOptions.ClearTypeHint="Enabled">

    <Border Style="{StaticResource NvDialogRoot}" Margin="8">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="58" />
                <RowDefinition Height="*" />
                <RowDefinition Height="72" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Margin="0,0,86,0"
                    Background="Transparent"
                    MouseLeftButtonDown="TitleDrag_MouseLeftButtonDown" />

            <Button Grid.Row="0"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    Margin="0,0,24,0"
                    Panel.ZIndex="30"
                    Style="{StaticResource NvDialogCloseButton}"
                    Click="Rollback_Click"
                    ToolTip="Откатить" />

            <ScrollViewer Grid.Row="1"
                          Margin="28,0,28,20"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          CanContentScroll="False"
                          PanningMode="VerticalOnly">

                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0"
                                   Text="ПОЛЬЗОВАТЕЛЬСКОЕ РАЗРЕШЕНИЕ"
                                   Style="{StaticResource NvLabel}"
                                   Foreground="{StaticResource NvGreenBrush}"
                                   TextTrimming="CharacterEllipsis" />

                        <TextBlock Grid.Row="1"
                                   Text="{Binding ModeLabel}"
                                   Style="{StaticResource NvHeader}"
                                   FontSize="28"
                                   Margin="0,6,0,14"
                                   TextWrapping="Wrap"
                                   TextTrimming="CharacterEllipsis" />

                        <TextBlock Grid.Row="2"
                                   Text="{Binding DescriptionText}"
                                   Foreground="{StaticResource NvTextSecondaryBrush}"
                                   FontSize="14"
                                   LineHeight="22"
                                   TextWrapping="Wrap" />

                        <TextBlock Grid.Row="3"
                                   Text="{Binding CountdownText}"
                                   Foreground="{StaticResource NvTextSecondaryBrush}"
                                   FontSize="15"
                                   FontWeight="SemiBold"
                                   Margin="0,22,0,0"
                                   TextWrapping="Wrap" />
                    </Grid>
            </ScrollViewer>

            <Border Grid.Row="2"
                    Background="#AA0E0F0E"
                    BorderBrush="{StaticResource NvGreenFaintBrush}"
                    BorderThickness="0,1,0,0">
                <Grid Margin="28,0">
                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center">
                        <Button Content="{Binding RollbackButtonText}"
                                Style="{StaticResource NvDialogButtonSecondary}"
                                Margin="0,0,12,0"
                                Click="Rollback_Click" />
                        <Button Content="Сохранить"
                                Style="{StaticResource NvDialogButtonPrimary}"
                                Click="Keep_Click" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
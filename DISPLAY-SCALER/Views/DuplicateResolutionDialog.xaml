<Window x:Class="DISPLAY_SCALER.Views.DuplicateResolutionDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Height="430" Width="690"
        MinHeight="430" MinWidth="690"
        Background="Transparent"
        WindowStartupLocation="CenterOwner"
        FontFamily="{StaticResource NvFont}"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True"
        ShowInTaskbar="False"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        RenderOptions.ClearTypeHint="Enabled">

    <Border Style="{StaticResource NvDialogRoot}" Margin="8">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="72" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Height="58"
                    Margin="0,0,86,0"
                    VerticalAlignment="Top"
                    Background="Transparent"
                    MouseLeftButtonDown="TitleDrag_MouseLeftButtonDown" />

            <Button Grid.Row="0"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Top"
                    Margin="0,14,24,0"
                    Panel.ZIndex="30"
                    Style="{StaticResource NvDialogCloseButton}"
                    Click="Ignore_Click"
                    ToolTip="Закрыть" />

            <Grid Grid.Row="0" Margin="28,58,28,20">
                <Border Style="{StaticResource NvDialogPanel}">
                    <StackPanel>
                        <TextBlock Text="ДУБЛИКАТ / КОНФЛИКТ" Style="{StaticResource NvLabel}" Foreground="{StaticResource NvGreenBrush}" />
                        <TextBlock Text="{Binding ModeLabel}" Style="{StaticResource NvHeader}" FontSize="26" Margin="0,6,0,16" />

                        <TextBlock Text="Такой режим уже найден на выбранном мониторе. Чтобы не плодить мусорные дубли, DISPLAY-SCALER может только добавить свой marker и не трогать запись драйвера."
                                   Foreground="{StaticResource NvTextSecondaryBrush}"
                                   FontSize="14"
                                   LineHeight="21"
                                   TextWrapping="Wrap"
                                   Margin="0,0,0,18" />

                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="230" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Windows mode list:" Style="{StaticResource NvLabel}" Margin="0,0,0,10" />
                            <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding WindowsModeListText}" FontFamily="{StaticResource NvMonoFont}" Foreground="{StaticResource NvTextPrimaryBrush}" FontSize="16" Margin="0,0,0,10" />

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="NVIDIA custom display:" Style="{StaticResource NvLabel}" Margin="0,0,0,10" />
                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding NvidiaCustomDisplayText}" FontFamily="{StaticResource NvMonoFont}" Foreground="{StaticResource NvTextPrimaryBrush}" FontSize="16" Margin="0,0,0,10" />

                            <TextBlock Grid.Row="2" Grid.Column="0" Text="DISPLAY-SCALER marker:" Style="{StaticResource NvLabel}" Margin="0,0,0,10" />
                            <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding DisplayScalerMarkerText}" FontFamily="{StaticResource NvMonoFont}" Foreground="{StaticResource NvGreenBrush}" FontSize="16" Margin="0,0,0,10" />

                            <TextBlock Grid.Row="3" Grid.Column="0" Text="Монитор:" Style="{StaticResource NvLabel}" />
                            <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding DisplayTitle}" Foreground="{StaticResource NvTextMutedBrush}" FontSize="13" TextTrimming="CharacterEllipsis" />
                        </Grid>

                        <Border Height="3" Background="{StaticResource NvGreenFaintBrush}" Margin="0,2,0,12" />
                        <TextBlock Text="Добавление marker не создаёт новый custom mode. Оно только говорит программе: этот уже существующий режим можно считать режимом DISPLAY-SCALER."
                                   Foreground="{StaticResource NvTextMutedBrush}"
                                   FontSize="13"
                                   LineHeight="20"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
            </Grid>

            <Border Grid.Row="1"
                    Background="#AA0E0F0E"
                    BorderBrush="{StaticResource NvGreenFaintBrush}"
                    BorderThickness="0,1,0,0">
                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Margin="28,0">
                    <Button Content="Не трогать"
                            Style="{StaticResource NvDialogButtonSecondary}"
                            Margin="0,0,12,0"
                            Click="Ignore_Click" />
                    <Button Content="Добавить marker"
                            Style="{StaticResource NvDialogButtonPrimary}"
                            Click="AddMarker_Click" />
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>